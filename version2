                <span class="text-slate-500 ml-2">({{ s.q5_wanPorts }} Links WAN / {{ s.q4_lanPorts }} Cabos LAN)</span>
              </div>
              <div class="text-slate-600 font-semibold">
                Banda: {{ s.q6_bandwidthValue }} {{ s.q6_bandwidthUnit }} | {{ s.q7_lanDevices + s.q8_wifiDevices + s.q11_voipExtensions + s.q3_mobileVpnUsers }} disp. atuais
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
