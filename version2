                  <div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded-full" :class="siteEval.recommendedBox ? 'bg-emerald-500' : 'bg-rose-500'"></span>
                      <span class="font-extrabold text-xs text-slate-900">{{ siteEval.site.name }}</span>
                      <span v-if="siteEval.site.quantity > 1" class="text-[10px] px-1.5 py-0.2 rounded bg-indigo-100 text-indigo-800 font-bold">
                        Lote {{ siteEval.site.quantity }} un.
                      </span>
                    </div>
                    <div class="text-[11px] text-slate-500 mt-0.5">
                      Banda: {{ formatMbps(siteEval.requiredBandwidthMbps) }} | {{ siteEval.totalUsersWithGrowth }} Users | {{ siteEval.totalRequiredPorts }} Portas
                    </div>
                  </div>
                  <div class="text-right shrink-0">
                    <span v-if="siteEval.recommendedBox" class="inline-block px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-900 font-black text-xs">
