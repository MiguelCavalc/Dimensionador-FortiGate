            <i class="ph-bold ph-SlidersHorizontal"></i>
            <span>Análise & Dimensionamento</span>
          </button>
          <button 
            @click="consultantTab = 'report'" 
            :class="consultantTab === 'report' ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'"
            class="px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition">
            <i class="ph-bold ph-FileText"></i>
            <span>Relatório Completo (PDF)</span>
          </button>
          <button 
            @click="consultantTab = 'specs'" 
            :class="consultantTab === 'specs' ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'"
            class="px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition">
            <i class="ph-bold ph-Memory"></i>
            <span class="hidden md:inline">Matriz RAM & Datasheets</span>
          </button>
        </div>
      </div>

      <!-- ========================================================================= -->
      <!-- ABA 1 DO CONSULTOR: ANALISADOR MULTI-FILIAL + BARRA DIREITA FIXA (STICKY) -->
      <!-- ========================================================================= -->
      <div v-if="consultantTab === 'analyzer' && currentSubmission" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start no-print">
        
        <!-- COLUNA ESQUERDA (7 COLUNAS): RESUMO GLOBAL + SELETOR DE UNIDADES + RESPOSTAS QPV -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Card BOM Consolidado (Todas as Unidades do Cliente) -->
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="bg-slate-900 text-white px-5 py-3.5 flex flex-wrap items-center justify-between gap-2">
              <div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-400">Visão Consolidada do Projeto (Multi-Filial)</span>
                <h2 class="text-base font-black">{{ currentSubmission.companyName }} — {{ totalMappedUnitsCount(currentSubmission) }} Localidade(s)</h2>
              </div>
              <div class="text-xs text-slate-300">
                Contato: <strong>{{ currentSubmission.contactName || 'N/A' }}</strong> | Cresc. Q9: <strong>+{{ currentSubmission.q9_growthPercent }}%</strong>
              </div>
            </div>

            <!-- Lista de Unidades (Clique para inspecionar cada filial na barra da direita!) -->
            <div class="p-4 bg-slate-50 border-b border-slate-200">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-extrabold uppercase tracking-wider text-slate-600">
                  Selecione a Unidade/Filial abaixo para ver o dimensionamento detalhado à direita:
                </span>
                <button @click="addSiteToCurrentSubmission" class="text-xs font-bold text-sky-700 hover:text-sky-900 flex items-center gap-1">
                  <i class="ph-bold ph-plus-circle"></i> + Adicionar Filial
                </button>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div v-for="(siteEval, idx) in evaluatedSubmissionSites" :key="siteEval.site.id"
