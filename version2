<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MUNDIVOX | Portal QPV Gamificado & Dimensionador FortiGate</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Vue.js 3 -->
  <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            fortired: '#EE3124',
            fortidark: '#0F172A',
            mundiblue: '#0284C7',
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #F1F5F9;
    }
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    @keyframes pulse-soft {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.03); }
    }
    .animate-pulse-soft {
      animation: pulse-soft 2.5s infinite ease-in-out;
    }
    @media print {
      body {
        background-color: #FFFFFF !important;
      }
      .no-print {
        display: none !important;
      }
      .print-break-avoid {
        page-break-inside: avoid;
      }
      .shadow-lg, .shadow-xl, .shadow-2xl, .shadow-md, .shadow-sm {
        box-shadow: none !important;
      }
    }
  </style>
</head>
<body class="text-slate-800 antialiased selection:bg-sky-600 selection:text-white">
  <div id="app" class="min-h-screen flex flex-col">

    <!-- ========================================================================= -->
    <!-- TOP NAVBAR GLOBAL (PERMITE TROCAR ENTRE PORTAL DO CLIENTE E CONSULTOR)    -->
    <!-- ========================================================================= -->
    <header class="sticky top-0 z-40 bg-slate-900/95 backdrop-blur text-white border-b-4 border-fortired shadow-lg no-print">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap justify-between items-center gap-3">
        <!-- Brand Logo -->
        <div class="flex items-center space-x-3 cursor-pointer" @click="appMode = 'landing'">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-500 to-blue-700 flex items-center justify-center shadow-md font-black text-xl tracking-tighter">
            MV
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-black text-lg tracking-wider text-white">MUNDIVOX</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-fortired text-white font-bold uppercase tracking-wider">Fortinet Partner</span>
            </div>
            <p class="text-[11px] text-slate-400">Portal Interativo QPV & Engenharia de Pré-Venda</p>
          </div>
        </div>

        <!-- Mode Switcher (Cliente vs Consultor) -->
        <div class="flex items-center gap-2">
          <button 
            @click="appMode = 'landing'"
            :class="appMode === 'landing' ? 'bg-slate-700 text-white' : 'bg-slate-800/80 text-slate-400 hover:text-white'"
            class="px-3 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition">
            <i class="ph-bold ph-SquaresFour text-sm"></i>
            <span class="hidden sm:inline">Início</span>
          </button>

          <button 
            @click="enterClientMode"
            :class="appMode === 'client' ? 'bg-gradient-to-r from-sky-500 to-blue-600 text-white shadow-md ring-2 ring-sky-400/40' : 'bg-slate-800 text-slate-300 hover:bg-slate-700'"
            class="px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-2 transition">
            <i class="ph-fill ph-game-controller text-base"></i>
            <span>Área do Cliente (Responder QPV)</span>
          </button>

          <button 
            @click="openConsultantGate"
            :class="appMode === 'consultant' ? 'bg-gradient-to-r from-emerald-600 to-teal-600 text-white shadow-md ring-2 ring-emerald-400/40' : 'bg-slate-800 text-slate-300 hover:bg-slate-700'"
            class="px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-2 transition">
            <i class="ph-fill ph-lock-key text-base"></i>
            <span>Área do Consultor</span>
            <span class="ml-1 px-1.5 py-0.2 rounded-full bg-slate-950/60 text-[10px] font-extrabold text-emerald-300">
              {{ submissions.length }}
            </span>
          </button>
        </div>
      </div>
    </header>

    <!-- TOAST NOTIFICATION -->
    <div v-if="toastMessage" class="fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl border border-slate-700 flex items-center gap-3 transition-all duration-300 no-print">
      <i class="ph-fill ph-check-circle text-emerald-400 text-xl"></i>
      <span class="text-sm font-medium">{{ toastMessage }}</span>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL DE LOGIN DO CONSULTOR (PIN / SENHA)                                 -->
    <!-- ========================================================================= -->
    <div v-if="showPinModal" class="fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-sm flex items-center justify-center p-4 no-print">
      <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 max-w-md w-full overflow-hidden">
        <div class="bg-slate-900 p-6 text-white flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
              <i class="ph-duotone ph-shield-star text-2xl"></i>
            </div>
            <div>
              <h3 class="font-extrabold text-base">Acesso Restrito — Consultor</h3>
              <p class="text-xs text-slate-400">Engenharia de Pré-Venda Mundivox</p>
            </div>
          </div>
          <button @click="showPinModal = false" class="text-slate-400 hover:text-white">
            <i class="ph-bold ph-x text-lg"></i>
          </button>
        </div>

        <form @submit.prevent="verifyConsultantPin" class="p-6 space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Credencial / PIN de Engenharia</label>
            <input 
              v-model="pinInput" 
              type="password" 
              autofocus
              placeholder="Digite a senha (ex: mundivox ou 1234)" 
              class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm font-bold text-slate-900 focus:ring-2 focus:ring-emerald-500 outline-none" />
            <p v-if="pinError" class="text-xs text-rose-600 font-semibold mt-1.5 flex items-center gap-1">
              <i class="ph-fill ph-warning-circle"></i> Senha incorreta. Tente "mundivox" ou "1234".
            </p>
          </div>

          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-500 flex items-center justify-between">
            <span><i class="ph-fill ph-info text-sky-600 mr-1"></i> Dica para demonstração:</span>
            <button type="button" @click="pinInput = 'mundivox'; verifyConsultantPin()" class="text-sky-700 font-bold underline hover:text-sky-900">
              Entrar direto (mundivox)
            </button>
          </div>

          <div class="flex justify-end gap-2 pt-2">
            <button type="button" @click="showPinModal = false" class="px-4 py-2.5 rounded-xl bg-slate-100 text-slate-600 text-xs font-bold hover:bg-slate-200">
              Cancelar
            </button>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold flex items-center gap-2 shadow-md">
              <i class="ph-bold ph-sign-in"></i>
              <span>Acessar Painel de Dimensionamento</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TELA 0: LANDING PAGE / ESCOLHA DE PERFIL DE ACESSO                        -->
    <!-- ========================================================================= -->
    <main v-if="appMode === 'landing'" class="flex-grow flex items-center justify-center p-4 sm:p-8 no-print">
      <div class="max-w-5xl w-full space-y-8">
        
        <div class="text-center space-y-3 max-w-2xl mx-auto">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-sky-100 text-sky-800">
            <i class="ph-fill ph-sparkle"></i> Novo QPV Digital Multi-Filial
          </span>
          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
            Bem-vindo ao Portal de Dimensionamento <span class="text-fortired">FortiGate</span>
          </h1>
          <p class="text-sm text-slate-600 leading-relaxed">
            Escolha como deseja acessar a plataforma: o <strong>Ambiente Gamificado do Cliente</strong> traduz termos técnicos em uma jornada visual super leve, enquanto a <strong>Área do Consultor</strong> entrega o cálculo automático das caixas, RAM, portas e justificativas.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- CARD 1: PORTAL DO CLIENTE (GAMIFICADO) -->
          <div @click="enterClientMode" class="group bg-white rounded-3xl p-8 shadow-xl border-2 border-transparent hover:border-sky-500 cursor-pointer transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute -right-8 -top-8 w-32 h-32 rounded-full bg-sky-500/10 group-hover:bg-sky-500/20 transition"></div>
            
            <div class="space-y-4 relative">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-sky-500 to-blue-600 text-white flex items-center justify-center shadow-lg">
                <i class="ph-duotone ph-rocket-launch text-3xl"></i>
              </div>
              <div class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-sky-700 bg-sky-50 px-2.5 py-1 rounded-md">
                Para Clientes Mundivox • Experiência Gamificada
              </div>
              <h2 class="text-2xl font-black text-slate-900">Sou Cliente (Responder QPV)</h2>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Mapeie sua Matriz e suas Filiais em menos de 3 minutos! Sem termos técnicos difíceis, com barras de progresso, agrupamento inteligente de lojas e dicas visuais.
              </p>

              <ul class="space-y-2 text-xs text-slate-600 pt-2">
                <li class="flex items-center gap-2">
                  <i class="ph-fill ph-check-circle text-sky-500 text-base"></i>
                  <span>Cadastre 1 unidade ou dezenas de filiais de uma só vez</span>
                </li>
                <li class="flex items-center gap-2">
                  <i class="ph-fill ph-check-circle text-sky-500 text-base"></i>
                  <span>Linguagem simples (sem precisar calcular portas ou túneis)</span>
                </li>
                <li class="flex items-center gap-2">
                  <i class="ph-fill ph-check-circle text-sky-500 text-base"></i>
                  <span>Desbloqueie conquistas ao completar o perfil da sua rede</span>
                </li>
              </ul>
            </div>

            <div class="mt-8 pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-bold text-sky-600 group-hover:translate-x-1 transition flex items-center gap-1.5">
                Iniciar Jornada Interativa <i class="ph-bold ph-arrow-right"></i>
              </span>
              <span class="text-[11px] text-slate-400 font-medium">Tempo médio: 2 min</span>
            </div>
          </div>

          <!-- CARD 2: PORTAL DO CONSULTOR (ENGENHARIA) -->
          <div @click="openConsultantGate" class="group bg-slate-900 text-white rounded-3xl p-8 shadow-xl border-2 border-slate-800 hover:border-emerald-500 cursor-pointer transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
            <div class="absolute -right-8 -top-8 w-32 h-32 rounded-full bg-emerald-500/10 group-hover:bg-emerald-500/20 transition"></div>

            <div class="space-y-4 relative">
              <div class="flex items-center justify-between">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex items-center justify-center shadow-lg">
                  <i class="ph-duotone ph-cpu text-3xl"></i>
                </div>
                <span class="px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-extrabold">
                  {{ submissions.length }} QPVs na Base
                </span>
              </div>
              <div class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/80 px-2.5 py-1 rounded-md">
                Acesso Restrito • Pré-Venda & Engenharia
              </div>
              <h2 class="text-2xl font-black text-white">Sou Consultor Mundivox</h2>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                Visualize os QPVs preenchidos pelos clientes, simule alterações em tempo real com a barra lateral fixa e veja a caixa ideal dimensionada para cada filial.
              </p>

              <ul class="space-y-2 text-xs text-slate-300 pt-2">
                <li class="flex items-center gap-2">
                  <i class="ph-fill ph-check-circle text-emerald-400 text-base"></i>
                  <span>Caixa dimensionada por RAM, Threat Protection e Portas</span>
                </li>
                <li class="flex items-center gap-2">
                  <i class="ph-fill ph-check-circle text-emerald-400 text-base"></i>
                  <span>Explicação do <strong>Porquê foi escolhida</strong> e <strong>Por que as outras 8 não foram</strong></span>
                </li>
                <li class="flex items-center gap-2">
                  <i class="ph-fill ph-check-circle text-emerald-400 text-base"></i>
                  <span>Relatório executivo completo de Matriz + Filiais pronto para PDF</span>
                </li>
              </ul>
            </div>

            <div class="mt-8 pt-4 border-t border-slate-800 flex items-center justify-between">
              <span class="text-xs font-bold text-emerald-400 group-hover:translate-x-1 transition flex items-center gap-1.5">
                Acessar Painel do Consultor <i class="ph-bold ph-lock-key-open"></i>
              </span>
              <span class="text-[11px] text-slate-400 font-mono">PIN: mundivox</span>
            </div>
          </div>

        </div>
      </div>
    </main>

    <!-- ========================================================================= -->
    <!-- TELA 1: ÁREA DO CLIENTE — JORNADA GAMIFICADA MULTI-FILIAL                 -->
    <!-- ========================================================================= -->
    <main v-if="appMode === 'client'" class="flex-grow max-w-5xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6 no-print">
      
      <!-- TOP GAMIFICATION HUD (BARRA DE MISSÃO E CONQUISTAS) -->
      <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-md border border-slate-200">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 text-white flex items-center justify-center shadow-md font-black text-xl">
              <i class="ph-fill ph-trophy"></i>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-extrabold uppercase tracking-wider text-sky-600">Jornada de Mapeamento Mundivox</span>
                <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 font-bold">
                  {{ clientProgressPercent }}% Concluído
                </span>
              </div>
              <h2 class="text-lg font-black text-slate-900">{{ clientLevelTitle }}</h2>
            </div>
          </div>

          <!-- Badges / Conquistas Desbloqueadas -->
          <div class="flex flex-wrap gap-2">
            <div v-for="badge in gamificationBadges" :key="badge.id"
              :class="badge.unlocked ? 'bg-amber-50 border-amber-300 text-amber-900 shadow-sm' : 'bg-slate-100 border-slate-200 text-slate-400 opacity-60'"
              class="px-3 py-1.5 rounded-xl border text-xs font-bold flex items-center gap-1.5 transition-all duration-300">
              <i :class="[badge.icon, badge.unlocked ? 'text-amber-500' : 'text-slate-400']" class="text-base"></i>
              <span>{{ badge.label }}</span>
            </div>
          </div>
        </div>

        <!-- Barra de Progresso Animada -->
        <div class="w-full bg-slate-100 h-3 rounded-full overflow-hidden p-0.5 border border-slate-200">
          <div class="bg-gradient-to-r from-sky-500 via-blue-600 to-emerald-500 h-full rounded-full transition-all duration-500"
               :style="{ width: clientProgressPercent + '%' }"></div>
        </div>

        <!-- Stepper de Navegação da Jornada -->
        <div class="grid grid-cols-4 gap-2 pt-4 mt-4 border-t border-slate-100 text-xs">
          <button @click="clientStep = 1" :class="clientStep === 1 ? 'bg-sky-600 text-white font-bold shadow-sm' : (clientStep > 1 ? 'bg-emerald-50 text-emerald-800 font-semibold' : 'bg-slate-50 text-slate-500')" class="p-2.5 rounded-xl flex items-center justify-center gap-2 transition">
            <i class="ph-bold ph-buildings"></i>
            <span class="hidden sm:inline">1. Sua Empresa</span>
            <span class="sm:hidden">1. Empresa</span>
          </button>
          <button @click="clientStep = 2" :class="clientStep === 2 ? 'bg-sky-600 text-white font-bold shadow-sm' : (clientStep > 2 ? 'bg-emerald-50 text-emerald-800 font-semibold' : 'bg-slate-50 text-slate-500')" class="p-2.5 rounded-xl flex items-center justify-center gap-2 transition">
            <i class="ph-bold ph-shield-check"></i>
            <span class="hidden sm:inline">2. Segurança & Futuro</span>
            <span class="sm:hidden">2. Proteção</span>
          </button>
          <button @click="clientStep = 3" :class="clientStep === 3 ? 'bg-sky-600 text-white font-bold shadow-sm' : (clientStep > 3 ? 'bg-emerald-50 text-emerald-800 font-semibold' : 'bg-slate-50 text-slate-500')" class="p-2.5 rounded-xl flex items-center justify-center gap-2 transition">
            <i class="ph-bold ph-map-pin-line"></i>
            <span class="hidden sm:inline">3. Matriz & Filiais ({{ clientDraft.sites.length }})</span>
            <span class="sm:hidden">3. Unidades</span>
          </button>
          <button @click="clientStep = 4" :class="clientStep === 4 ? 'bg-emerald-600 text-white font-bold shadow-sm' : 'bg-slate-50 text-slate-500'" class="p-2.5 rounded-xl flex items-center justify-center gap-2 transition">
            <i class="ph-bold ph-paper-plane-tilt"></i>
            <span class="hidden sm:inline">4. Concluir Missão</span>
            <span class="sm:hidden">4. Enviar</span>
          </button>
        </div>
      </div>

      <!-- ========================================================= -->
      <!-- PASSO 1 DO CLIENTE: BOAS-VINDAS & DADOS DA EMPRESA        -->
      <!-- ========================================================= -->
      <div v-if="clientStep === 1" class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-sky-600">Etapa 1 de 4 • Ponto de Partida</span>
            <h3 class="text-2xl font-black text-slate-900 mt-1">Quem está embarcando nessa missão?</h3>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Não se preocupe com números exatos agora. Se não souber algum detalhe, uma estimativa próxima já ajuda nossa engenharia!
            </p>
          </div>
          <div class="hidden sm:flex w-14 h-14 rounded-2xl bg-sky-50 text-sky-600 items-center justify-center shrink-0">
            <i class="ph-duotone ph-hand-waving text-3xl"></i>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1.5">Nome da sua Empresa *</label>
            <input v-model="clientDraft.companyName" type="text" placeholder="Ex: Rede Supermercados Estrela" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold focus:ring-2 focus:ring-sky-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1.5">Seu Nome / Cargo *</label>
            <input v-model="clientDraft.contactName" type="text" placeholder="Ex: Carlos Silva (Gestor de TI)" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold focus:ring-2 focus:ring-sky-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1.5">E-mail ou WhatsApp de Contato</label>
            <input v-model="clientDraft.contactEmail" type="text" placeholder="Ex: carlos@empresa.com.br / (11) 99999-0000" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold focus:ring-2 focus:ring-sky-500 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1.5">Observações Gerais do Projeto (Opcional)</label>
            <input v-model="clientDraft.notes" type="text" placeholder="Ex: Queremos interligar as lojas com a matriz" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold focus:ring-2 focus:ring-sky-500 outline-none" />
          </div>
        </div>

        <!-- Declaração Amigável -->
        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex items-start gap-3">
          <i class="ph-fill ph-info text-sky-600 text-xl mt-0.5"></i>
          <p class="text-xs text-slate-600 leading-relaxed">
            <strong>Transparência Mundivox:</strong> As informações preenchidas servem como base oficial para desenharmos a solução na medida certa para sua rede, sem superdimensionar nem deixar faltar capacidade.
          </p>
        </div>

        <div class="flex justify-end pt-2">
          <button @click="clientStep = 2" class="px-6 py-3.5 rounded-2xl bg-sky-600 hover:bg-sky-700 text-white font-extrabold text-sm flex items-center gap-2 shadow-lg transition">
            <span>Avançar para Diretrizes da Rede</span>
            <i class="ph-bold ph-arrow-right"></i>
          </button>
        </div>
      </div>

      <!-- ========================================================= -->
      <!-- PASSO 2 DO CLIENTE: DIRETRIZES GLOBAIS (Q9, Q12, Q1/Q2)   -->
      <!-- ========================================================= -->
      <div v-if="clientStep === 2" class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 space-y-8">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-wider text-sky-600">Etapa 2 de 4 • Visão Estratégica (Responde 1 única vez)</span>
          <h3 class="text-2xl font-black text-slate-900 mt-1">Como sua empresa vai crescer e se proteger?</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Essas 3 escolhas valem como regra geral para toda a empresa, poupando seu tempo!
          </p>
        </div>

        <!-- 1. Crescimento Esperado (Q9) -->
        <div class="space-y-3">
