              </span>
              <div class="flex flex-wrap gap-2">
                <span v-for="(count, sku) in projectBomSummary" :key="sku" class="px-2.5 py-1 rounded-md bg-emerald-600 text-white font-black text-xs shadow-sm">
                  {{ count }}x {{ sku }}
                </span>
              </div>
            </div>
          </div>

          <!-- FORMULÁRIO TÉCNICO COMPLETO DAS 13 QUESTÕES DO QPV (EDITÁVEL PELO CONSULTOR) -->
          <div v-if="currentConsultantSite" class="bg-white rounded-2xl shadow-sm border border-slate-200 divide-y divide-slate-200">
            
            <div class="p-5 bg-slate-900 text-white rounded-t-2xl flex flex-wrap items-center justify-between gap-3">
              <div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-sky-400">Inspeção & Edição Técnica do QPV</span>
                <h3 class="text-lg font-black">Respostas da Unidade: {{ currentConsultantSite.name }}</h3>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-xs text-slate-300">Qtd. de filiais iguais:</span>
                <input v-model.number="currentConsultantSite.quantity" type="number" min="1" class="w-16 rounded-lg bg-slate-800 border border-slate-700 px-2.5 py-1 text-xs font-black text-white text-center" />
              </div>
            </div>

            <!-- Q1 & Q2: VPN Site-to-Site -->
            <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-bold text-slate-800 mb-1">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-slate-800 text-white text-[11px] mr-1">1</span>
                  Quantas VPN Site-to-Site serão configuradas?
                </label>
                <input v-model.number="currentConsultantSite.q1_vpnSiteToSite" type="number" min="0" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-bold" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-800 mb-1">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-slate-800 text-white text-[11px] mr-1">2</span>
                  Quantos túneis dentro destas VPNs?
                </label>
                <input v-model.number="currentConsultantSite.q2_vpnTunnels" type="number" min="0" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-bold" />
              </div>
            </div>

            <!-- Q3: Mobile VPN -->
            <div class="p-5 bg-sky-50/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-sky-600 text-white text-[11px] font-bold mr-1">3</span>
                <label class="text-xs font-bold text-slate-900">Quantos usuários utilizarão Mobile VPN nesta unidade?</label>
                <span class="ml-2 text-[10px] bg-sky-100 text-sky-800 px-2 py-0.5 rounded-full font-bold">Soma nos Usuários</span>
              </div>
              <input v-model.number="currentConsultantSite.q3_mobileVpnUsers" type="number" min="0" class="sm:w-40 rounded-xl border border-sky-300 bg-white px-3 py-2 text-sm font-black text-sky-950" />
            </div>

            <!-- Q4 & Q5: Portas LAN e WAN -->
            <div class="p-5 bg-indigo-50/30 grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-bold text-slate-900 mb-1">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-600 text-white text-[11px] mr-1">4</span>
                  Quantas Interfaces LAN são necessárias?
                </label>
                <input v-model.number="currentConsultantSite.q4_lanPorts" type="number" min="1" class="w-full rounded-xl border border-indigo-300 bg-white px-3 py-2 text-sm font-black text-indigo-950" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-900 mb-1">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-600 text-white text-[11px] mr-1">5</span>
                  Quantas Interfaces WAN são necessárias?
                </label>
                <input v-model.number="currentConsultantSite.q5_wanPorts" type="number" min="1" class="w-full rounded-xl border border-indigo-300 bg-white px-3 py-2 text-sm font-black text-indigo-950" />
              </div>
            </div>

            <!-- Q6: Banda Total -->
            <div class="p-5 bg-rose-50/30 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-fortired text-white text-[11px] font-bold mr-1">6</span>
                <label class="text-xs font-bold text-slate-900">Somatória das bandas dos links (Internet + MPLS/L2L)</label>
                <p class="text-[11px] text-slate-500">Validado contra <em>Threat Protection Throughput</em>.</p>
              </div>
              <div class="flex gap-2 sm:w-52">
                <input v-model.number="currentConsultantSite.q6_bandwidthValue" type="number" min="1" step="any" class="w-full rounded-xl border border-rose-300 bg-white px-3 py-2 text-sm font-black" />
                <select v-model="currentConsultantSite.q6_bandwidthUnit" class="rounded-xl border border-rose-300 bg-white px-2.5 py-2 text-xs font-bold">
                  <option value="Mbps">Mbps</option>
                  <option value="Gbps">Gbps</option>
                </select>
              </div>
            </div>

            <!-- Q7, Q8 e Q11: Dispositivos LAN, Wi-Fi e Ramais VoIP -->
            <div class="p-5 bg-sky-50/40 grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-900 mb-1">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-sky-600 text-white text-[11px] mr-1">7</span>
                  Dispositivos Rede LAN
                </label>
                <input v-model.number="currentConsultantSite.q7_lanDevices" type="number" min="0" class="w-full rounded-xl border border-sky-300 bg-white px-3 py-2 text-sm font-black text-sky-950" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-900 mb-1">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-sky-600 text-white text-[11px] mr-1">8</span>
                  Dispositivos via Wi-Fi
                </label>
                <input v-model.number="currentConsultantSite.q8_wifiDevices" type="number" min="0" class="w-full rounded-xl border border-sky-300 bg-white px-3 py-2 text-sm font-black text-sky-950" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-900 mb-1">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-sky-600 text-white text-[11px] mr-1">11</span>
                  Ramais Telefonia VoIP
                </label>
                <input v-model.number="currentConsultantSite.q11_voipExtensions" type="number" min="0" class="w-full rounded-xl border border-sky-300 bg-white px-3 py-2 text-sm font-black text-sky-950" />
              </div>
            </div>

            <!-- Q9, Q10 e Q12 -->
            <div class="p-5 grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-900 mb-1">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-sky-600 text-white text-[11px] mr-1">9</span>
                  Crescimento 12-36m (%)
                </label>
                <input v-model.number="currentSubmission.q9_growthPercent" type="number" min="0" max="500" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-black" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-900 mb-1">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-slate-800 text-white text-[11px] mr-1">10</span>
                  Cluster HA na Unidade
                </label>
                <select v-model="currentConsultantSite.q10_haMode" class="w-full rounded-xl border border-slate-300 px-2.5 py-2 text-xs font-bold">
                  <option value="Não">Não (1x Caixa)</option>
                  <option value="Sim - Ativo/Passivo">Sim - Ativo/Passivo (2x)</option>
                  <option value="Sim - Ativo/Ativo">Sim - Ativo/Ativo (2x)</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-900 mb-1">
                  <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-slate-800 text-white text-[11px] mr-1">12</span>
                  Plano Segurança
                </label>
                <select v-model="currentSubmission.q12_securityPlan" class="w-full rounded-xl border border-slate-300 px-2.5 py-2 text-xs font-bold">
                  <option value="UTP (Unified Threat Protection)">UTP (Unified Threat Protection)</option>
                  <option value="FortiCare">FortiCare</option>
                </select>
              </div>
            </div>

            <!-- Q13: Serviços Adicionais -->
            <div class="p-5">
              <label class="block text-xs font-bold text-slate-900 mb-2">
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-slate-800 text-white text-[11px] mr-1">13</span>
                Serviços Adicionais nesta Unidade:
              </label>
              <div class="flex flex-wrap gap-2">
                <button v-for="srv in ['FortiAP', 'FortiSwitch', 'FortiAnalyzer', 'FortiManager']" :key="srv"
                  type="button"
                  @click="toggleSiteService(currentConsultantSite, srv)"
                  :class="currentConsultantSite.q13_additionalServices.includes(srv) ? 'bg-sky-600 text-white font-bold' : 'bg-slate-100 text-slate-600'"
                  class="px-3 py-1.5 rounded-xl text-xs transition">
                  {{ srv }}
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- ========================================================================= -->
        <!-- COLUNA DIREITA FIXA (5 COLUNAS - STICKY): CAIXA, O PORQUÊ E DESCARTADAS   -->
        <!-- ========================================================================= -->
        <div v-if="activeSiteEvaluation" class="lg:col-span-5 lg:sticky lg:top-24 space-y-5 self-start">
          
          <!-- CARD PRINCIPAL: CAIXA DIMENSIONADA + O PORQUÊ FOI ESCOLHIDA -->
          <div class="bg-white rounded-2xl shadow-xl border-2 border-slate-900 overflow-hidden">
            
            <div class="bg-slate-900 text-white px-5 py-3.5 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <h2 class="text-xs font-extrabold uppercase tracking-wider">
                  Dimensionamento: {{ activeSiteEvaluation.site.name }}
                </h2>
              </div>
              <span class="text-[11px] bg-slate-800 text-emerald-300 px-2.5 py-0.5 rounded font-mono font-bold">
                Ao Vivo
              </span>
            </div>

            <!-- Caso Estoure a 200G -->
            <div v-if="!activeSiteEvaluation.recommendedBox" class="p-6 bg-rose-50 text-center space-y-3">
              <i class="ph-duotone ph-warning-octagon text-5xl text-fortired mx-auto"></i>
              <h3 class="text-base font-black text-rose-950">Acima da Capacidade do FortiGate 200G</h3>
              <p class="text-xs text-rose-800">
                Esta unidade exige <strong>{{ formatMbps(activeSiteEvaluation.requiredBandwidthMbps) }}</strong>, <strong>{{ activeSiteEvaluation.totalUsersWithGrowth }} usuários</strong> e <strong>{{ activeSiteEvaluation.totalRequiredPorts }} portas</strong>. Considere modelos da série 400F/600F.
              </p>
            </div>

            <!-- Caixa Recomendada + O PORQUÊ -->
            <div v-else class="p-5 space-y-4">
              
              <div class="flex items-start justify-between gap-3 border-b border-slate-100 pb-4">
                <div>
                  <div class="flex flex-wrap items-center gap-1.5 mb-1">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800 uppercase">
                      Caixa Ideal Escolhida
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-900">
                      {{ activeSiteEvaluation.recommendedBox.ramGb }} GB RAM
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700">
                      {{ activeSiteEvaluation.recommendedBox.formFactor }}
                    </span>
                  </div>
                  <h3 class="text-2xl font-black text-slate-900">
                    {{ activeSiteEvaluation.appliancesPerSite }}x {{ activeSiteEvaluation.recommendedBox.name }}
                  </h3>
                  <p class="text-xs text-slate-500">
                    SKU: <strong class="text-slate-800">{{ activeSiteEvaluation.recommendedBox.sku }}</strong> | Licença: <strong class="text-slate-800">{{ currentSubmission.q12_securityPlan }}</strong>
                  </p>
                  <p v-if="activeSiteEvaluation.site.quantity > 1" class="text-xs font-extrabold text-indigo-700 mt-1">
                    <i class="ph-fill ph-stack"></i> Para o lote de {{ activeSiteEvaluation.site.quantity }} unidades: Total de {{ activeSiteEvaluation.totalAppliancesForThisSiteGroup }}x caixas
                  </p>
                </div>

                <div :class="activeSiteEvaluation.appliancesPerSite === 2 ? 'bg-emerald-600 text-white' : 'bg-slate-900 text-white'" class="px-3 py-2 rounded-xl text-center shrink-0">
                  <div class="text-lg font-black leading-none">{{ activeSiteEvaluation.appliancesPerSite }} UN</div>
                  <div class="text-[9px] font-bold uppercase mt-1 opacity-90">
                    {{ activeSiteEvaluation.appliancesPerSite === 2 ? 'Cluster HA' : 'Por Local' }}
                  </div>
                </div>
              </div>

              <!-- BOX VERDE: POR QUE ESTA CAIXA FOI ESCOLHIDA? -->
              <div class="p-3.5 rounded-xl bg-emerald-50/80 border border-emerald-200 space-y-1.5">
                <div class="text-xs font-extrabold text-emerald-950 flex items-center gap-1.5">
                  <i class="ph-fill ph-check-seal text-emerald-600 text-base"></i>
                  Por que o {{ activeSiteEvaluation.recommendedBox.name }} foi escolhido?
                </div>
