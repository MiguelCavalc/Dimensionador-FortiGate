          <button @click="createNewSubmissionInConsultant" class="px-3 py-2 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 text-xs font-bold flex items-center gap-1.5">
            <i class="ph-bold ph-plus"></i> Novo Projeto
          </button>

          <label class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold flex items-center gap-1.5 cursor-pointer">
            <i class="ph-bold ph-upload-simple"></i> Importar QPV (.json)
            <input type="file" accept=".json" @change="importQpvJson" class="hidden" />
          </label>
        </div>

        <!-- Sub-Abas do Consultor -->
        <div class="flex items-center gap-2">
          <button 
