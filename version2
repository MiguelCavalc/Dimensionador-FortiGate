          }
        });

        function saveSubmissionsToStorage() {
          try {
            localStorage.setItem('mundivox_qpv_submissions_v2', JSON.stringify(submissions.value));
          } catch (e) {
            console.warn('Erro ao salvar no LocalStorage:', e);
          }
        }

        // Computeds da Gamificação do Cliente
        const currentClientSite = computed(() => {
          return clientDraft.sites[activeClientSiteIndex.value] || clientDraft.sites[0];
        });

        const clientProgressPercent = computed(() => {
          if (clientStep.value === 4) return 100;
          let pts = 15;
          if (clientDraft.companyName.trim().length > 2) pts += 20;
          if (clientDraft.contactName.trim().length > 2) pts += 15;
          if (clientStep.value >= 2) pts += 20;
          if (clientStep.value >= 3) pts += 25;
          return Math.min(95, pts);
        });

        const clientLevelTitle = computed(() => {
          const p = clientProgressPercent.value;
          if (p < 40) return 'Nível 1: Iniciando o Mapeamento da Rede';
          if (p < 70) return 'Nível 2: Estrategista de Conectividade & Segurança';
          if (p < 100) return 'Nível 3: Arquiteto Multi-Filial (Quase lá!)';
          return 'Nível Máximo: Rede 100% Mapeada para Engenharia!';
        });

        const gamificationBadges = computed(() => [
          { id: 'b1', label: 'Identificação OK', icon: 'ph-fill ph-identification-badge', unlocked: clientDraft.companyName.trim().length > 2 },
          { id: 'b2', label: 'Guardião da Segurança', icon: 'ph-fill ph-shield-star', unlocked: clientStep.value >= 2 },
          { id: 'b3', label: `Arquiteto (${totalMappedUnitsCount(clientDraft)} un.)`, icon: 'ph-fill ph-buildings', unlocked: clientStep.value >= 3 },
          { id: 'b4', label: 'Missão Cumprida!', icon: 'ph-fill ph-trophy', unlocked: clientStep.value === 4 }
        ]);

        // Funções da Jornada do Cliente
        function enterClientMode() {
          appMode.value = 'client';
          if (clientStep.value === 4) clientStep.value = 1;
        }

        function setVpnTopology(type) {
          clientDraft.vpnTopology = type;
          const totalSites = totalMappedUnitsCount(clientDraft);
          clientDraft.sites.forEach((s, idx) => {
            if (type === 'single') {
              s.q1_vpnSiteToSite = 0;
              s.q2_vpnTunnels = 0;
            } else if (type === 'star') {
              s.q1_vpnSiteToSite = idx === 0 ? Math.max(1, totalSites - 1) : 1;
              s.q2_vpnTunnels = idx === 0 ? Math.max(2, (totalSites - 1) * 2) : 2;
            } else {
              s.q1_vpnSiteToSite = Math.max(2, totalSites);
              s.q2_vpnTunnels = Math.max(4, totalSites * 2);
            }
          });
        }

        function addClientSite(mode) {
          const idx = clientDraft.sites.length + 1;
          clientDraft.sites.push({
            id: 'site-' + Date.now() + '-' + idx,
            name: mode === 'batch' ? `Lote de Filiais Padrão #${idx}` : `Filial 0${idx - 1}`,
            quantity: mode === 'batch' ? 5 : 1,
            q1_vpnSiteToSite: 1,
            q2_vpnTunnels: 2,
            q3_mobileVpnUsers: 0,
            q4_lanPorts: 2,
            q5_wanPorts: 1,
            q6_bandwidthValue: 300,
            q6_bandwidthUnit: 'Mbps',
            q7_lanDevices: 12,
            q8_wifiDevices: 10,
            q10_haMode: 'Não',
            q11_voipExtensions: 5,
            q13_additionalServices: []
          });
          activeClientSiteIndex.value = clientDraft.sites.length - 1;
          showToast(mode === 'batch' ? 'Lote de filiais adicionado!' : 'Nova filial adicionada!');
        }

        function removeClientSite(index) {
          if (clientDraft.sites.length <= 1) return;
          clientDraft.sites.splice(index, 1);
          activeClientSiteIndex.value = Math.max(0, index - 1);
        }

        function toggleSiteService(site, srv) {
          const i = site.q13_additionalServices.indexOf(srv);
          if (i >= 0) {
            site.q13_additionalServices.splice(i, 1);
          } else {
            site.q13_additionalServices.push(srv);
          }
        }

        function finishClientJourney() {
          const newSub = JSON.parse(JSON.stringify(clientDraft));
          newSub.id = 'sub-' + Date.now();
          if (!newSub.companyName.trim()) {
            newSub.companyName = 'Cliente Mundivox #' + (submissions.value.length + 1);
          }
          newSub.submittedAt = new Date().toLocaleDateString('pt-BR');
          submissions.value.unshift(newSub);
          selectedSubmissionId.value = newSub.id;
          selectedSiteIndex.value = 0;
          saveSubmissionsToStorage();
          clientStep.value = 4;
          showToast('QPV enviado com sucesso para a Engenharia Mundivox!');
        }

        function startNewClientDraft() {
          clientDraft.companyName = '';
          clientDraft.contactName = '';
          clientDraft.contactEmail = '';
          clientDraft.notes = '';
          clientStep.value = 1;
          activeClientSiteIndex.value = 0;
        }

        // Controle de Acesso ao Consultor
        function openConsultantGate() {
          if (isConsultantAuthenticated.value) {
            appMode.value = 'consultant';
          } else {
            pinInput.value = '';
            pinError.value = false;
            showPinModal.value = true;
          }
        }

        function verifyConsultantPin() {
          const clean = pinInput.value.trim().toLowerCase();
          if (clean === 'mundivox' || clean === '1234' || clean === 'admin') {
            isConsultantAuthenticated.value = true;
            showPinModal.value = false;
            appMode.value = 'consultant';
            showToast('Acesso de Consultor liberado!');
          } else {
            pinError.value = true;
          }
        }

        function openConsultantDirectWithLastSubmission() {
          isConsultantAuthenticated.value = true;
          appMode.value = 'consultant';
          consultantTab.value = 'analyzer';
        }

        // MOTOR DE DIMENSIONAMENTO DO CONSULTOR (POR UNIDADE E CONSOLIDADO)
        const currentSubmission = computed(() => {
          return submissions.value.find(s => s.id === selectedSubmissionId.value) || submissions.value[0];
        });

        const currentConsultantSite = computed(() => {
          if (!currentSubmission.value) return null;
          return currentSubmission.value.sites[selectedSiteIndex.value] || currentSubmission.value.sites[0];
        });

        // Função pura que avalia uma única unidade contra todas as 9 caixas FortiGate
        function evaluateSingleSite(site, growthPercent) {
          const q3 = Number(site.q3_mobileVpnUsers) || 0;
          const q7 = Number(site.q7_lanDevices) || 0;
          const q8 = Number(site.q8_wifiDevices) || 0;
          const q11 = Number(site.q11_voipExtensions) || 0;
          const baseUsers = q3 + q7 + q8 + q11;
          const growth = Number(growthPercent) || 0;
          const totalUsersWithGrowth = Math.ceil(baseUsers * (1 + growth / 100));

          const lanPorts = Number(site.q4_lanPorts) || 0;
          const wanPorts = Number(site.q5_wanPorts) || 0;
          const totalRequiredPorts = lanPorts + wanPorts;

          const bwVal = Number(site.q6_bandwidthValue) || 0;
          const requiredBandwidthMbps = site.q6_bandwidthUnit === 'Gbps' ? bwVal * 1000 : bwVal;

          const requiredTunnels = Math.max(Number(site.q1_vpnSiteToSite) || 0, Number(site.q2_vpnTunnels) || 0);

          const evaluatedBoxes = firewallModels.map(box => {
            const failReasons = [];

            if (box.threatProtectionMbps < requiredBandwidthMbps) {
              failReasons.push(`Banda Threat Protection insuficiente: suporta ${formatMbps(box.threatProtectionMbps)}, exige ${formatMbps(requiredBandwidthMbps)}`);
            }
            if (totalUsersWithGrowth > box.maxUsersByRam) {
              failReasons.push(`Limite de Usuários/RAM excedido: suporta ${box.maxUsersByRam} (${box.ramGb}GB RAM), exige ${totalUsersWithGrowth}`);
            }
            if (box.totalConfigurablePorts < totalRequiredPorts) {
              failReasons.push(`Portas insuficientes: possui ${box.totalConfigurablePorts} portas, exige ${totalRequiredPorts} (${lanPorts} LAN + ${wanPorts} WAN)`);
            }
            if (requiredTunnels > box.maxSiteToSiteTunnels) {
              failReasons.push(`Túneis VPN insuficientes: suporta ${box.maxSiteToSiteTunnels}, exige ${requiredTunnels}`);
            }

            return {
              ...box,
              failReasons,
              passedAll: failReasons.length === 0
            };
          });

          const validBoxes = evaluatedBoxes.filter(b => b.passedAll);
          validBoxes.sort((a, b) => {
            if (a.threatProtectionMbps !== b.threatProtectionMbps) {
              return a.threatProtectionMbps - b.threatProtectionMbps;
            }
            return a.tierOrder - b.tierOrder;
          });

          const recommendedBox = validBoxes.length > 0 ? validBoxes[0] : null;
          const appliancesPerSite = site.q10_haMode === 'Não' ? 1 : 2;
          const siteQty = Math.max(1, Number(site.quantity) || 1);
          const totalAppliancesForThisSiteGroup = appliancesPerSite * siteQty;

          return {
            site,
            baseUsers,
            totalUsersWithGrowth,
            totalRequiredPorts,
            requiredBandwidthMbps,
            evaluatedBoxes,
            recommendedBox,
            appliancesPerSite,
            totalAppliancesForThisSiteGroup
          };
        }

        const evaluatedSubmissionSites = computed(() => {
          if (!currentSubmission.value) return [];
          return currentSubmission.value.sites.map(site =>
            evaluateSingleSite(site, currentSubmission.value.q9_growthPercent)
          );
        });

        const activeSiteEvaluation = computed(() => {
          return evaluatedSubmissionSites.value[selectedSiteIndex.value] || evaluatedSubmissionSites.value[0] || null;
        });

        const projectBomSummary = computed(() => {
          const map = {};
          evaluatedSubmissionSites.value.forEach(item => {
            if (item.recommendedBox) {
              const sku = item.recommendedBox.sku;
              map[sku] = (map[sku] || 0) + item.totalAppliancesForThisSiteGroup;
            }
          });
          return map;
        });

        function addSiteToCurrentSubmission() {
          if (!currentSubmission.value) return;
          const idx = currentSubmission.value.sites.length + 1;
          currentSubmission.value.sites.push({
            id: 'site-c-' + Date.now(),
            name: `Nova Filial 0${idx}`,
            quantity: 1,
            q1_vpnSiteToSite: 1,
            q2_vpnTunnels: 2,
            q3_mobileVpnUsers: 0,
            q4_lanPorts: 2,
            q5_wanPorts: 1,
            q6_bandwidthValue: 400,
            q6_bandwidthUnit: 'Mbps',
            q7_lanDevices: 15,
            q8_wifiDevices: 10,
            q10_haMode: 'Não',
            q11_voipExtensions: 5,
            q13_additionalServices: []
          });
          selectedSiteIndex.value = currentSubmission.value.sites.length - 1;
          saveSubmissionsToStorage();
        }

        function createNewSubmissionInConsultant() {
          const newSub = {
            id: 'sub-' + Date.now(),
            companyName: 'Novo Cliente Simulado #' + (submissions.value.length + 1),
            contactName: 'Consultor Mundivox',
            contactEmail: 'prevenda@mundivox.com.br',
            submittedAt: new Date().toLocaleDateString('pt-BR'),
            q9_growthPercent: 15,
            q12_securityPlan: 'UTP (Unified Threat Protection)',
            vpnTopology: 'star',
            sites: [
              {
                id: 's-new-1',
                name: 'Matriz Principal',
                quantity: 1,
                q1_vpnSiteToSite: 2,
                q2_vpnTunnels: 4,
                q3_mobileVpnUsers: 10,
                q4_lanPorts: 3,
                q5_wanPorts: 2,
                q6_bandwidthValue: 600,
                q6_bandwidthUnit: 'Mbps',
                q7_lanDevices: 30,
                q8_wifiDevices: 20,
                q10_haMode: 'Não',
                q11_voipExtensions: 10,
                q13_additionalServices: []
              }
            ]
          };
          submissions.value.unshift(newSub);
          selectedSubmissionId.value = newSub.id;
          selectedSiteIndex.value = 0;
          saveSubmissionsToStorage();
          showToast('Novo projeto criado no painel do consultor!');
        }

        // Exportar / Importar JSON
        function exportSingleQpvJson(subObj) {
          const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(subObj, null, 2));
          const a = document.createElement('a');
          a.setAttribute('href', dataStr);
          const safeName = (subObj.companyName || 'qpv-mundivox').toLowerCase().replace(/[^a-z0-9]/g, '-');
          a.setAttribute('download', `qpv-${safeName}.json`);
          document.body.appendChild(a);
          a.click();
          a.remove();
          showToast('Arquivo QPV (.json) exportado!');
        }

        function importQpvJson(event) {
          const file = event.target.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = (e) => {
            try {
              const imported = JSON.parse(e.target.result);
              if (imported && Array.isArray(imported.sites)) {
                imported.id = 'sub-imp-' + Date.now();
                submissions.value.unshift(imported);
                selectedSubmissionId.value = imported.id;
                selectedSiteIndex.value = 0;
                saveSubmissionsToStorage();
                showToast('QPV importado com sucesso!');
              }
            } catch (err) {
              showToast('Erro ao ler o arquivo JSON.');
            }
          };
          reader.readAsText(file);
        }

        // Helpers Gerais
        function totalMappedUnitsCount(sub) {
          if (!sub || !Array.isArray(sub.sites)) return 0;
          return sub.sites.reduce((acc, s) => acc + (Number(s.quantity) || 1), 0);
        }

        function formatMbps(mbps) {
          if (mbps >= 1000) {
            return (mbps / 1000).toLocaleString('pt-BR', { maximumFractionDigits: 2 }) + ' Gbps';
          }
          return mbps + ' Mbps';
        }

        function printConsultantReport() {
          window.print();
        }

        function showToast(msg) {
          toastMessage.value = msg;
          setTimeout(() => {
            toastMessage.value = '';
          }, 3200);
        }

        return {
          appMode,
          showPinModal,
          pinInput,
          pinError,
          isConsultantAuthenticated,
          toastMessage,
          clientStep,
          activeClientSiteIndex,
          consultantTab,
          selectedSubmissionId,
          selectedSiteIndex,
          firewallModels,
          clientDraft,
          submissions,
          currentClientSite,
          clientProgressPercent,
          clientLevelTitle,
          gamificationBadges,
          enterClientMode,
          setVpnTopology,
          addClientSite,
          removeClientSite,
          toggleSiteService,
          finishClientJourney,
          startNewClientDraft,
          openConsultantGate,
          verifyConsultantPin,
          openConsultantDirectWithLastSubmission,
          currentSubmission,
          currentConsultantSite,
          evaluatedSubmissionSites,
          activeSiteEvaluation,
          projectBomSummary,
          addSiteToCurrentSubmission,
          createNewSubmissionInConsultant,
          exportSingleQpvJson,
          importQpvJson,
          totalMappedUnitsCount,
          formatMbps,
          printConsultantReport
        };
      }
    }).mount('#app');
  </script>
</body>
</html>
